# Backend settings. Copy to .env and fill in. Never commit .env.
# Everything works offline with the defaults below (mock AI, dev login).

ENV=development                 # development | production
AUTH_MODE=dev                   # dev | firebase (dev only allowed when ENV=development)
FIREBASE_PROJECT_ID=             # required when AUTH_MODE=firebase (Firebase console > Project settings)

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=intervueai

# LLM provider chains, tried left to right. Names: groq, gemini, nim, mock
LLM_CHAIN=mock                  # e.g. groq,gemini
LLM_CHAIN_REPORT=mock           # e.g. gemini,groq

# Groq (OpenAI-compatible). IDs checked against console.groq.com/docs/models (Oct 2026).
# gpt-oss models support strict JSON-schema structured outputs on Groq.
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REPORT=openai/gpt-oss-120b

# Gemini. IDs checked against ai.google.dev/gemini-api/docs/models (Oct 2026); both have a free tier.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REPORT=gemini-3.8-flash

# Optional NVIDIA NIM (OpenAI-compatible). Pick a model id from build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Speech to text chain. Names: groq, local, mock
STT_CHAIN=mock                  # e.g. groq,local
GROQ_STT_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_MODEL=small.en

MAX_UPLOAD_MB=5
MAX_SEGMENT_MB=3
MAX_QUESTIONS_DEFAULT=8
TIME_LIMIT_MINUTES_DEFAULT=25
CORS_ORIGINS=http://localhost:5173
